-- ── REACH ───────────────────────────────────
local function stopReach()
	S.reachOn = false
	if S.reachConn then S.reachConn:Disconnect(); S.reachConn = nil end
	if S.reachPart and S.reachPart.Parent then S.reachPart:Destroy() end
	S.reachPart = nil
	-- restore any modified tool handles
	local char = getChar()
	if char then
		for _, tool in ipairs(char:GetChildren()) do
			if tool:IsA("Tool") then
				local handle = tool:FindFirstChild("Handle")
				if handle then
					local origSize = handle:GetAttribute("_AdminOrigSize")
					if origSize then
						handle.Size = origSize
						handle.Transparency = handle:GetAttribute("_AdminOrigTransp") or 0
						handle:SetAttribute("_AdminOrigSize", nil)
						handle:SetAttribute("_AdminOrigTransp", nil)
					end
				end
			end
		end
	end
end

local function startReach()
	local char = getChar()
	if not char then 
		notify("No character", "error")
		return false
	end

	-- Check if a tool is currently equipped
	local hasTool = false
	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then
			hasTool = true
			break
		end
	end

	if not hasTool then
		notify("Equip a tool first!", "error")
		return false
	end

	stopReach()
	S.reachOn = true

	-- create the rectangle outline showing reach range
	local rect = Instance.new("Part")
	rect.Name = "_AdminReachRect"
	rect.Shape = Enum.PartType.Block
	rect.Size = Vector3.new(4, 0.2, S.reachValue)
	rect.Transparency = 0.5
	rect.Color = P.accent
	rect.Material = Enum.Material.Neon
	rect.CanCollide = false
	rect.CanQuery = false
	rect.Anchored = true
	rect.Parent = workspace
	S.reachPart = rect

	S.reachConn = conn(RunService.Heartbeat:Connect(function()
		if not S.reachOn then return end
		local hrp = getHRP()
		if not hrp or not hrp.Parent then return end

		-- position the rectangle in front of the character's feet
		if S.reachPart and S.reachPart.Parent then
			S.reachPart.Size = Vector3.new(4, 0.2, S.reachValue)
			S.reachPart.CFrame = hrp.CFrame * CFrame.new(0, -2.5, -S.reachValue / 2)
			S.reachPart.Color = P.accent
		end

		-- extend all equipped tool handles
		local charObj = getChar()
		if charObj then
			local foundTool = false
			for _, tool in ipairs(charObj:GetChildren()) do
				if tool:IsA("Tool") then
					foundTool = true
					local handle = tool:FindFirstChild("Handle")
					if handle then
						-- save original size on first touch
						if not handle:GetAttribute("_AdminOrigSize") then
							handle:SetAttribute("_AdminOrigSize", handle.Size)
							handle:SetAttribute("_AdminOrigTransp", handle.Transparency)
						end
						handle.Size = Vector3.new(1, 1, S.reachValue)
						handle.Transparency = 1
						handle.Massless = true
					end
				end
			end
			-- hide visualizer if no tool is equipped
			if S.reachPart and S.reachPart.Parent then
				S.reachPart.Transparency = foundTool and 0.5 or 1
			end
		end
	end))
	return true
end

-- ── HITBOX EXPANDER ─────────────────────────
local HITBOX_HEAD_PARTS  = {"Head"}
local HITBOX_TORSO_PARTS = {"Torso", "UpperTorso", "LowerTorso"}
local HITBOX_LEG_PARTS   = {"Left Leg", "Right Leg", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}

local function stopHitbox()
	S.hitboxOn = false
	if S.hitboxConn then S.hitboxConn:Disconnect(); S.hitboxConn = nil end
	-- restore all original sizes
	for part, origSize in pairs(S.hitboxOrigSizes) do
		if part and part.Parent then
			part.Size = origSize
		end
	end
	S.hitboxOrigSizes = {}
	-- remove highlights
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character then
			local hl = plr.Character:FindFirstChild("_AHitboxHL")
			if hl then hl:Destroy() end
		end
	end
end

local function getHitboxPartNames()
	local parts = {}
	if S.hitboxHead then
		for _, n in ipairs(HITBOX_HEAD_PARTS) do table.insert(parts, n) end
	end
	if S.hitboxTorso then
		for _, n in ipairs(HITBOX_TORSO_PARTS) do table.insert(parts, n) end
	end
	if S.hitboxLegs then
		for _, n in ipairs(HITBOX_LEG_PARTS) do table.insert(parts, n) end
	end
	return parts
end

local function startHitbox()
	stopHitbox()
	S.hitboxOn = true

	S.hitboxConn = conn(RunService.Heartbeat:Connect(function()
		if not S.hitboxOn then return end
		local targetParts = getHitboxPartNames()

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP and plr.Character then
				local char = plr.Character

				-- apply size expansion
				for _, partName in ipairs(targetParts) do
					local part = char:FindFirstChild(partName)
					if part and part:IsA("BasePart") then
						if not S.hitboxOrigSizes[part] then
							S.hitboxOrigSizes[part] = part.Size
						end
						local orig = S.hitboxOrigSizes[part]
						part.Size = orig * S.hitboxSize
						part.Transparency = 0.7
						part.CanCollide = false
					end
				end

				-- handle outline highlight
				if S.hitboxOutline then
					if not char:FindFirstChild("_AHitboxHL") then
						local hl = Instance.new("Highlight")
						hl.Name = "_AHitboxHL"
						hl.FillColor = P.accent
						hl.FillTransparency = 0.85
						hl.OutlineColor = P.accent
						hl.OutlineTransparency = 0.3
						hl.Parent = char
					end
				else
					local hl = char:FindFirstChild("_AHitboxHL")
					if hl then hl:Destroy() end
				end
			end
		end
	end))
end

