local function bindAccent(obj, prop)
	table.insert(S.accentElements, {obj = obj, prop = prop})
	obj[prop] = P.accent
end
local function updateAccent(col)
	P.accent = col
	for _, a in ipairs(S.accentElements) do
		if a.obj and a.obj.Parent then a.obj[a.prop] = col end
	end
	if S.espOn then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then
				local hl = plr.Character:FindFirstChild("_AESP")
				if hl then hl.FillColor = col end
			end
		end
	end
	-- update reach ring color
	if S.reachPart and S.reachPart.Parent then
		S.reachPart.Color = col
	end
	-- update hitbox outlines
	if S.hitboxOn then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP and plr.Character then
				local hl = plr.Character:FindFirstChild("_AHitboxHL")
				if hl then hl.OutlineColor = col; hl.FillColor = col end
			end
		end
	end
end

