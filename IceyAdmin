local CMDS = {}
local CMD_LOOKUP = {}

local function defCmd(name, aliases, args, desc, cat, fn)
	local entry = {name = name, aliases = aliases, args = args, desc = desc, category = cat, callback = fn}
	table.insert(CMDS, entry)
	CMD_LOOKUP[name:lower()] = entry
	for _, a in ipairs(aliases) do CMD_LOOKUP[a:lower()] = entry end
end

