local _nid = 0
local function notify(msg, kind)
	kind = kind or "info"
	_nid = _nid + 1

	local cols = {success = P.green, error = P.red, warning = P.yellow, info = P.blue}
	local icons = {success = "+", error = "x", warning = "!", info = "i"}
	local accentCol = cols[kind] or P.blue
	local icon      = icons[kind] or "i"

	local f = make("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = P.bg,
		BackgroundTransparency = 0.06,
		ClipsDescendants = true,
		LayoutOrder = _nid,
		Parent = notifHolder,
	})
	corner(f, 8)
	stroke(f, accentCol, 1, 0.55)

	local bar = make("Frame", {
		Size = UDim2.new(0, 3, 0.55, 0),
		Position = UDim2.new(0, 7, 0.225, 0),
		BackgroundColor3 = accentCol,
		BorderSizePixel = 0,
		Parent = f,
	})
	corner(bar, 2)

	make("TextLabel", {
		Text = icon,
		Font = Enum.Font.GothamBold, TextSize = 13,
		TextColor3 = accentCol,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 18, 1, 0),
		Position = UDim2.new(0, 16, 0, 0),
		Parent = f,
	})
	make("TextLabel", {
		Text = msg,
		Font = Enum.Font.GothamMedium, TextSize = 12,
		TextColor3 = P.text,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -42, 1, 0),
		Position = UDim2.new(0, 38, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = f,
	})

	-- animate in
	tw(f, {Size = UDim2.new(1, 0, 0, 34)}, 0.25)

	-- auto dismiss
	task.delay(3.2, function()
		if f and f.Parent then
			tw(f, {Size = UDim2.new(1, 0, 0, 0)}, 0.25)
			task.wait(0.28)
			if f and f.Parent then f:Destroy() end
		end
	end)
end

