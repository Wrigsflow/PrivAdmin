-- ── FREECAM ─────────────────────────────────
local freecamYaw, freecamPitch = 0, 0

local function stopFreecam()
	S.freecamOn = false
	if S.freecamConn then S.freecamConn:Disconnect(); S.freecamConn = nil end
	Camera.CameraType = Enum.CameraType.Custom
	UIS.MouseBehavior = Enum.MouseBehavior.Default
	local hrp = getHRP()
	if hrp and S.origFCAnchored ~= nil then hrp.Anchored = S.origFCAnchored end
end

local function startFreecam()
	local hrp = getHRP()
	if not hrp then return false end
	stopFreecam()
	
	S.freecamOn = true
	S.origFCAnchored = hrp.Anchored
	hrp.Anchored = true
	
	Camera.CameraType = Enum.CameraType.Scriptable
	local camCFrame = Camera.CFrame
	local rx, ry, rz = camCFrame:ToOrientation()
	freecamYaw = ry
	freecamPitch = rx
	
	S.freecamConn = conn(RunService.RenderStepped:Connect(function(dt)
		if not S.freecamOn then return end
		
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			local delta = UIS:GetMouseDelta()
			freecamYaw = freecamYaw - delta.X * 0.005
			freecamPitch = math.clamp(freecamPitch - delta.Y * 0.005, -math.rad(89), math.rad(89))
		else
			UIS.MouseBehavior = Enum.MouseBehavior.Default
		end
		
		camCFrame = CFrame.new(camCFrame.Position) * CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
		
		if not input:IsFocused() then
			local dir = Vector3.zero
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + camCFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - camCFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - camCFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + camCFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
			if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.yAxis end
			
			if dir.Magnitude > 0 then
				camCFrame = camCFrame + (dir.Unit * 80 * dt)
			end
		end
		Camera.CFrame = camCFrame
	end))
	return true
end

