-- ║  FPS + COORDS UPDATE LOOP                ║
-- ╚═══════════════════════════════════════════╝
do
	local frames = 0
	local elapsed = 0

	conn(RunService.RenderStepped:Connect(function(dt)
		-- FPS
		frames = frames + 1
		elapsed = elapsed + dt
		if elapsed >= 0.5 then
			if S.showFps then
				fpsLabel.Text = "FPS: " .. math.floor(frames / elapsed + 0.5)
			end
			frames = 0
			elapsed = 0
		end

		-- Coords
		if S.showCoords then
			local hrp = getHRP()
			if hrp then
				local p = hrp.Position
				coordsLabel.Text = string.format("X: %.1f   Y: %.1f   Z: %.1f", p.X, p.Y, p.Z)
			end
		end
	end))
end

