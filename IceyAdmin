local function setScale(s)
	local hum = getHum()
	if not hum then return false end
	local names = {"BodyDepthScale", "BodyHeightScale", "BodyWidthScale", "HeadScale"}
	local ok = false
	for _, n in ipairs(names) do
		local sv = hum:FindFirstChild(n)
		if sv and sv:IsA("NumberValue") then sv.Value = s; ok = true end
	end
	return ok
end

