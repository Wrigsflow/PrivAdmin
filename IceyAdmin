-- ── ESP ─────────────────────────────────────
local function clearESP()
	S.espOn = false
	for _, c in ipairs(S.espConns) do pcall(function() c:Disconnect() end) end
	S.espConns = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character then
			local h = plr.Character:FindFirstChild("_AESP")
			local b = plr.Character:FindFirstChild("_AESPName")
			if h then h:Destroy() end
			if b then b:Destroy() end
		end
	end
end

local function espPlayer(plr)
	if plr == LP then return end

	local function onChar(char)
		task.wait(0.3)
		if not S.espOn or not char or not char.Parent then return end
		-- remove old
		local old = char:FindFirstChild("_AESP")
		if old then old:Destroy() end
		local oldb = char:FindFirstChild("_AESPName")
		if oldb then oldb:Destroy() end

		local hl = Instance.new("Highlight")
		hl.Name = "_AESP"
		hl.FillColor = P.accent
		hl.FillTransparency = 0.65
		hl.OutlineColor = Color3.new(1, 1, 1)
		hl.OutlineTransparency = 0
		hl.Parent = char

		local head = char:FindFirstChild("Head")
		if head then
			local bb = Instance.new("BillboardGui")
			bb.Name = "_AESPName"
			bb.Size = UDim2.new(0, 140, 0, 28)
			bb.StudsOffset = Vector3.new(0, 2.8, 0)
			bb.AlwaysOnTop = true
			bb.Adornee = head
			bb.Parent = char
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, 0, 1, 0)
			lbl.BackgroundTransparency = 1
			lbl.Text = plr.DisplayName
			lbl.TextColor3 = Color3.new(1, 1, 1)
			lbl.TextStrokeTransparency = 0.3
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 14
			lbl.TextScaled = false
			lbl.Parent = bb
		end
	end

	if plr.Character then onChar(plr.Character) end
	local c = plr.CharacterAdded:Connect(function(ch)
		if S.espOn then onChar(ch) end
	end)
	table.insert(S.espConns, c)
end

local function enableESP()
	clearESP()
	S.espOn = true
	for _, plr in ipairs(Players:GetPlayers()) do espPlayer(plr) end
	local c = Players.PlayerAdded:Connect(function(plr)
		if S.espOn then espPlayer(plr) end
	end)
	table.insert(S.espConns, c)
end

