local function bindAccent(obj, prop)
	table.insert(S.accentElements, {obj = obj, prop = prop})
	obj[prop] = P.accent
end
local function updateAccent(col)
	P.accent = col
	for _, a in ipairs(S.accentElements) do
		if a.obj and a.obj.Parent then a.obj[a.prop] = col end
	end
	if S.espOn then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then
				local hl = plr.Character:FindFirstChild("_AESP")
				if hl then hl.FillColor = col end
			end
		end
	end
end

