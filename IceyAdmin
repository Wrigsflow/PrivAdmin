-- ╚═══════════════════════════════════════════╝
local MAX_SUGGESTIONS = 6

local function updateSuggestions()
	-- clear old
	for _, ch in ipairs(sugFrame:GetChildren()) do
		if ch:IsA("TextButton") then ch:Destroy() end
	end

	local query = input.Text
	-- strip leading ;
	if query:sub(1, 1) == ";" then query = query:sub(2) end
	query = query:match("^%s*(.-)%s*$"):lower()

	if query == "" then
		sugFrame.Visible = false
		return
	end

	local matches = {}
	for _, cmd in ipairs(CMDS) do
		local matched = false
		if cmd.name:lower():sub(1, #query) == query then
			matched = true
		else
			for _, a in ipairs(cmd.aliases) do
				if a:lower():sub(1, #query) == query then matched = true; break end
			end
		end
		if matched then
			table.insert(matches, cmd)
			if #matches >= MAX_SUGGESTIONS then break end
		end
	end

	if #matches == 0 then
		sugFrame.Visible = false
		return
	end

	sugFrame.Visible = true
	for i, cmd in ipairs(matches) do
		local usage = cmd.name
		if cmd.args ~= "" then usage = usage .. "  " .. cmd.args end

		local btn = make("TextButton", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = P.bgLight,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			LayoutOrder = i,
			Parent = sugFrame,
		})
		corner(btn, 6)

		make("TextLabel", {
			Text = usage,
			Font = Enum.Font.GothamMedium, TextSize = 13,
			TextColor3 = P.text,
			BackgroundTransparency = 1,
			Size = UDim2.new(0.45, 0, 1, 0),
			Position = UDim2.new(0, 10, 0, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = btn,
		})
		make("TextLabel", {
			Text = cmd.desc,
			Font = Enum.Font.Gotham, TextSize = 12,
			TextColor3 = P.dim,
			BackgroundTransparency = 1,
			Size = UDim2.new(0.55, -14, 1, 0),
			Position = UDim2.new(0.45, 0, 0, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = btn,
		})

		btn.MouseEnter:Connect(function() tw(btn, {BackgroundTransparency = 0.3}, 0.12) end)
		btn.MouseLeave:Connect(function() tw(btn, {BackgroundTransparency = 1}, 0.12) end)
		btn.MouseButton1Click:Connect(function()
			input.Text = cmd.name .. " "
			input:CaptureFocus()
		end)
	end
end

