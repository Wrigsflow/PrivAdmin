-- ── PANEL SEARCH FILTER ─────────────────────
local function filterCmdPanel(query)
	query = query:lower():match("^%s*(.-)%s*$")
	local visibleCats = {}

	for _, item in ipairs(_cmdPanelRows) do
		local cmd = item.cmd
		local matched = (query == "")
		if not matched then
			-- match command name
			if cmd.name:lower():find(query, 1, true) then
				matched = true
			end
			-- match aliases
			if not matched then
				for _, a in ipairs(cmd.aliases) do
					if a:lower():find(query, 1, true) then matched = true; break end
				end
			end
			-- match description
			if not matched then
				if cmd.desc:lower():find(query, 1, true) then
					matched = true
				end
			end
			-- match category
			if not matched then
				if cmd.category:lower():find(query, 1, true) then
					matched = true
				end
			end
		end

		item.frame.Visible = matched
		if matched then
			visibleCats[cmd.category] = true
		end
	end

	for cat, header in pairs(_cmdCatHeaders) do
		header.Visible = (query == "" or visibleCats[cat] == true)
	end
end

conn(panelSearch:GetPropertyChangedSignal("Text"):Connect(function()
	filterCmdPanel(panelSearch.Text)
end))

