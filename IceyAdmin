-- ║  COMMAND  EXECUTION                       ║
-- ╚═══════════════════════════════════════════╝
local function execCmd(raw)
	-- strip leading ;
	if raw:sub(1, 1) == ";" then raw = raw:sub(2) end
	raw = raw:match("^%s*(.-)%s*$") -- trim
	if raw == "" then return end

	local parts = {}
	for w in raw:gmatch("%S+") do table.insert(parts, w) end
	local name = parts[1]:lower()
	local args = {}
	for i = 2, #parts do table.insert(args, parts[i]) end

	local entry = CMD_LOOKUP[name]
	if not entry then
		notify("Unknown command: " .. name, "error")
		return
	end

	-- special: cmds toggles panel
	if entry.name == "cmds" then
		S.panelOpen = not S.panelOpen
		tw(panel, {Position = S.panelOpen and PANEL_SHOWN or PANEL_HIDDEN}, 0.4)
		return
	end

	entry.callback(args)
end

