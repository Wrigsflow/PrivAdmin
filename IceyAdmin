conn(UIS.InputBegan:Connect(function(inp, gp)
	if gp then return end
	if S.chamsWaitingKey then return end
	if inp.KeyCode == S.chamsMenuKey then
		if S.chamsMenuOpen then
			closeChamsMenu()
		else
			openChamsMenu()
		end
	end
end))

-- true invis hotkey
conn(UIS.InputBegan:Connect(function(inp, gp)
	if gp then return end
	if inp.UserInputType == Enum.UserInputType.Keyboard then
		if S.trueInvisKey and inp.KeyCode == S.trueInvisKey then
			toggleFEInvis()
		end
	end
end))

-- suppress the ; that was used to OPEN the bar
conn(input:GetPropertyChangedSignal("Text"):Connect(function()
	if suppressSemicolon then
		suppressSemicolon = false
		if input.Text == ";" then
			input.Text = ""
			return
		end
	end
	updateSuggestions()
end))

-- enter -> execute, escape -> close
conn(input.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		local raw = input.Text
		closeBar()
		task.defer(function()
			execCmd(raw)
		end)
	else
		closeBar()
	end
end))

-- close commands panel
conn(panelClose.MouseButton1Click:Connect(function()
	S.panelOpen = false
	tw(panel, {Position = PANEL_HIDDEN}, 0.35)
end))

