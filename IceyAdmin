local function setFullbright(on)
	if on then
		S.fullbright = true
		S.origLighting = {
			Brightness      = Lighting.Brightness,
			ClockTime       = Lighting.ClockTime,
			FogEnd          = Lighting.FogEnd,
			FogStart        = Lighting.FogStart,
			GlobalShadows   = Lighting.GlobalShadows,
			Ambient         = Lighting.Ambient,
			OutdoorAmbient  = Lighting.OutdoorAmbient,
		}
		Lighting.Brightness     = 2
		Lighting.ClockTime      = 14
		Lighting.FogEnd         = 1e6
		Lighting.FogStart       = 1e6
		Lighting.GlobalShadows  = false
		Lighting.Ambient        = Color3.fromRGB(178, 178, 178)
		Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)

		S.hiddenEffects = {}
		for _, e in ipairs(Lighting:GetChildren()) do
			if e:IsA("Atmosphere") or e:IsA("BloomEffect") or e:IsA("BlurEffect")
				or e:IsA("ColorCorrectionEffect") or e:IsA("SunRaysEffect") then
				table.insert(S.hiddenEffects, {e, e.Enabled})
				e.Enabled = false
			end
		end
	else
		S.fullbright = false
		local o = S.origLighting
		if o.Brightness then
			Lighting.Brightness     = o.Brightness
			Lighting.ClockTime      = o.ClockTime
			Lighting.FogEnd         = o.FogEnd
			Lighting.FogStart       = o.FogStart
			Lighting.GlobalShadows  = o.GlobalShadows
			Lighting.Ambient        = o.Ambient
			Lighting.OutdoorAmbient = o.OutdoorAmbient
		end
		for _, d in ipairs(S.hiddenEffects) do
			if d[1] and d[1].Parent then d[1].Enabled = d[2] end
		end
		S.hiddenEffects = {}
	end
end

