-- ║  COMMAND  EXECUTION                       ║
-- ╚═══════════════════════════════════════════╝
local function execCmd(raw)
	-- strip leading ;
	if raw:sub(1, 1) == ";" then raw = raw:sub(2) end
	raw = raw:match("^%s*(.-)%s*$") -- trim
	if raw == "" then return end

	local parts = {}
	for w in raw:gmatch("%S+") do table.insert(parts, w) end
	local name = parts[1]:lower()
	local args = {}
	for i = 2, #parts do table.insert(args, parts[i]) end

	local entry = CMD_LOOKUP[name]
	if not entry then
		notify("Unknown command: " .. name, "error")
		return
	end

	-- special: cmds toggles panel
	if entry.name == "cmds" then
		S.panelOpen = not S.panelOpen
		tw(panel, {Position = S.panelOpen and PANEL_SHOWN or PANEL_HIDDEN}, 0.4)
		return
	end

	entry.callback(args)
end

-- ╔═══════════════════════════════════════════╗
-- ║  SUGGESTION SYSTEM                        ║
-- ╚═══════════════════════════════════════════╝
local MAX_SUGGESTIONS = 6

local function updateSuggestions()
	-- clear old
	for _, ch in ipairs(sugFrame:GetChildren()) do
		if ch:IsA("TextButton") then ch:Destroy() end
	end

	local query = input.Text
	-- strip leading ;
	if query:sub(1, 1) == ";" then query = query:sub(2) end
	query = query:match("^%s*(.-)%s*$"):lower()

	if query == "" then
		sugFrame.Visible = false
		return
	end

	local matches = {}
	for _, cmd in ipairs(CMDS) do
		-- match command name or aliases
		local matched = false
		if cmd.name:lower():sub(1, #query) == query then
			matched = true
		else
			for _, a in ipairs(cmd.aliases) do
				if a:lower():sub(1, #query) == query then matched = true; break end
			end
		end
		if matched then
			table.insert(matches, cmd)
			if #matches >= MAX_SUGGESTIONS then break end
		end
	end

	if #matches == 0 then
		sugFrame.Visible = false
		return
	end

	sugFrame.Visible = true
	for i, cmd in ipairs(matches) do
		local usage = cmd.name
		if cmd.args ~= "" then usage = usage .. "  " .. cmd.args end

		local btn = make("TextButton", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = P.bgLight,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			LayoutOrder = i,
			Parent = sugFrame,
		})
		corner(btn, 6)

		make("TextLabel", {
			Text = usage,
			Font = Enum.Font.GothamMedium, TextSize = 13,
			TextColor3 = P.text,
			BackgroundTransparency = 1,
			Size = UDim2.new(0.45, 0, 1, 0),
			Position = UDim2.new(0, 10, 0, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = btn,
		})
		make("TextLabel", {
			Text = cmd.desc,
			Font = Enum.Font.Gotham, TextSize = 12,
			TextColor3 = P.dim,
			BackgroundTransparency = 1,
			Size = UDim2.new(0.55, -14, 1, 0),
			Position = UDim2.new(0.45, 0, 0, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = btn,
		})

		btn.MouseEnter:Connect(function() tw(btn, {BackgroundTransparency = 0.3}, 0.12) end)
		btn.MouseLeave:Connect(function() tw(btn, {BackgroundTransparency = 1}, 0.12) end)
		btn.MouseButton1Click:Connect(function()
			input.Text = cmd.name .. " "
			input:CaptureFocus()
			-- move cursor to end (Roblox handles this automatically on CaptureFocus after text change)
		end)
	end
end

-- ╔═══════════════════════════════════════════╗
-- ║  BAR OPEN / CLOSE                         ║
-- ╚═══════════════════════════════════════════╝
local suppressSemicolon = false

local function openBar()
	if S.barOpen then return end
	S.barOpen = true
	suppressSemicolon = true
	input.Text = ""
	sugFrame.Visible = false
	tw(barWrap, {Position = BAR_Y_SHOWN}, 0.35)
	-- wait for the animation to be underway before focusing
	task.defer(function()
		input:CaptureFocus()
	end)
end

local function closeBar()
	if not S.barOpen then return end
	S.barOpen = false
	input:ReleaseFocus()
	sugFrame.Visible = false
	tw(barWrap, {Position = BAR_Y_HIDDEN}, 0.3)
end

-- ╔═══════════════════════════════════════════╗
-- ║  INPUT WIRING                             ║
-- ╚═══════════════════════════════════════════╝
-- open bar with ;
conn(UIS.InputBegan:Connect(function(inp, gp)
	if gp then return end
	if inp.KeyCode == Enum.KeyCode.Semicolon then
		if not S.barOpen then
			openBar()
		end
	end
end))

-- suppress the ; that was used to OPEN the bar
conn(input:GetPropertyChangedSignal("Text"):Connect(function()
	if suppressSemicolon then
		suppressSemicolon = false
		if input.Text == ";" then
			input.Text = ""
			return
		end
	end
	updateSuggestions()
end))

-- enter → execute, escape → close
conn(input.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		local raw = input.Text
		closeBar()
		-- small delay so bar animates out before side‑effects
		task.defer(function()
			execCmd(raw)
		end)
	else
		-- lost focus without enter (clicked away / pressed escape)
		closeBar()
	end
end))

-- close commands panel
conn(panelClose.MouseButton1Click:Connect(function()
	S.panelOpen = false
	tw(panel, {Position = PANEL_HIDDEN}, 0.35)
end))

