-- ── INVISIBILITY ────────────────────────────
local function toggleFEInvis()
	S.trueInvisOn = not S.trueInvisOn
	local char = getChar()
	if not char then return end

	if S.trueInvisOn then
		S.origTransp = {}
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") and p.Transparency == 0 then
				S.origTransp[p] = p.Transparency
				p.Transparency = 0.5
			end
		end
		
		if S.trueInvisConn then S.trueInvisConn:Disconnect() end
		
		S.trueInvisConn = conn(RunService.Heartbeat:Connect(function()
			if not S.trueInvisOn then return end
			local hrp = getHRP()
			local hum = getHum()
			if not hrp or not hum then return end
			
			local origCFrame = hrp.CFrame
			local origCamOffset = hum.CameraOffset
			local fakeCFrame = origCFrame * CFrame.new(0, -200000, 0)
			
			local posOffset = fakeCFrame:ToObjectSpace(CFrame.new(origCFrame.Position)).Position
			
			hrp.CFrame = fakeCFrame
			hum.CameraOffset = posOffset
			
			RunService.RenderStepped:Wait()
			
			local currentHum = getHum()
			if not currentHum then return end
			hrp.CFrame = origCFrame
			currentHum.CameraOffset = origCamOffset
		end))
		notify("Invisible", "success")
	else
		for p, orig in pairs(S.origTransp) do
			if p and p.Parent then p.Transparency = orig end
		end
		S.origTransp = {}
		if S.trueInvisConn then
			S.trueInvisConn:Disconnect()
			S.trueInvisConn = nil
		end
		local hum = getHum()
		if hum then hum.CameraOffset = Vector3.zero end
		notify("Visible", "info")
	end
end

