-- ── FLY ─────────────────────────────────────
local function stopFly()
	S.flying = false
	if S.flyConn then S.flyConn:Disconnect(); S.flyConn = nil end
	local hum = getHum()
	if hum then hum.PlatformStand = false end
	local hrp = getHRP()
	if hrp then
		local bv = hrp:FindFirstChild("_AdminBV")
		local bg = hrp:FindFirstChild("_AdminBG")
		if bv then bv:Destroy() end
		if bg then bg:Destroy() end
	end
end

local function startFly()
	local hrp = getHRP()
	local hum = getHum()
	if not hrp or not hum then return false end

	stopFly()

	local bv = Instance.new("BodyVelocity")
	bv.Name = "_AdminBV"
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.Velocity = Vector3.zero
	bv.Parent = hrp

	local bg = Instance.new("BodyGyro")
	bg.Name = "_AdminBG"
	bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	bg.P = 9e4
	bg.CFrame = hrp.CFrame
	bg.Parent = hrp

	S.flying = true
	hum.PlatformStand = true

	S.flyConn = conn(RunService.RenderStepped:Connect(function()
		if not S.flying then return end
		if not hrp or not hrp.Parent then stopFly(); return end
		local bv2 = hrp:FindFirstChild("_AdminBV")
		local bg2 = hrp:FindFirstChild("_AdminBG")
		if not bv2 or not bg2 then stopFly(); return end

		if input:IsFocused() then
			bv2.Velocity = Vector3.zero
			return
		end

		local cam = Camera.CFrame
		local dir = Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.yAxis end

		bv2.Velocity = dir.Magnitude > 0 and dir.Unit * S.flySpeed or Vector3.zero
		bg2.CFrame = cam
	end))
	return true
end

-- ── CFLY ────────────────────────────────────
local function stopCFly()
	S.cflying = false
	if S.cflyConn then S.cflyConn:Disconnect(); S.cflyConn = nil end
	local hum = getHum()
	if hum then hum.PlatformStand = false end
	local hrp = getHRP()
	if hrp then hrp.Anchored = false end
end

local function startCFly()
	local hrp = getHRP()
	local hum = getHum()
	if not hrp or not hum then return false end

	stopCFly()
	stopFly()

	S.cflying = true
	hum.PlatformStand = true
	hrp.Anchored = true

	S.cflyConn = conn(RunService.Heartbeat:Connect(function(dt)
		if not S.cflying then return end
		if not hrp or not hrp.Parent then stopCFly(); return end

		if input:IsFocused() then return end

		local cam = Camera.CFrame
		local dir = Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.yAxis end

		local newPos = hrp.Position
		if dir.Magnitude > 0 then
			newPos = newPos + (dir.Unit * S.cflySpeed * dt)
		end
		
		hrp.CFrame = CFrame.lookAt(newPos, newPos + cam.LookVector)
	end))
	return true
end

