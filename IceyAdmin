-- ── FREECAM ─────────────────────────────────
local freecamYaw, freecamPitch = 0, 0

local function stopFreecam()
	S.freecamOn = false
	if S.freecamConn then S.freecamConn:Disconnect(); S.freecamConn = nil end
	Camera.CameraType = Enum.CameraType.Custom
	UIS.MouseBehavior = Enum.MouseBehavior.Default
	local hrp = getHRP()
	if hrp and S.origFCAnchored ~= nil then hrp.Anchored = S.origFCAnchored end
end

local function startFreecam()
	local hrp = getHRP()
	if not hrp then return false end
	stopFreecam()
	
	S.freecamOn = true
	S.origFCAnchored = hrp.Anchored
	hrp.Anchored = true
	
	Camera.CameraType = Enum.CameraType.Scriptable
	local camCFrame = Camera.CFrame
	local rx, ry, rz = camCFrame:ToOrientation()
	freecamYaw = ry
	freecamPitch = rx
	
	S.freecamConn = conn(RunService.RenderStepped:Connect(function(dt)
		if not S.freecamOn then return end
		
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			local delta = UIS:GetMouseDelta()
			freecamYaw = freecamYaw - delta.X * 0.005
			freecamPitch = math.clamp(freecamPitch - delta.Y * 0.005, -math.rad(89), math.rad(89))
		else
			UIS.MouseBehavior = Enum.MouseBehavior.Default
		end
		
		camCFrame = CFrame.new(camCFrame.Position) * CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
		
		if not input:IsFocused() then
			local dir = Vector3.zero
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + camCFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - camCFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - camCFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + camCFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
			if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.yAxis end
			
			if dir.Magnitude > 0 then
				camCFrame = camCFrame + (dir.Unit * 80 * dt)
			end
		end
		Camera.CFrame = camCFrame
	end))
	return true
end

-- ── FLING ───────────────────────────────────
local _flingOldPos = nil
local function stopFlingAll()
	S.flingAllOn = false
	if S.flingAllThread then task.cancel(S.flingAllThread); S.flingAllThread = nil end
end

local function stopFling()
	S.flinging = false
	if S.flingConn then S.flingConn:Disconnect(); S.flingConn = nil end
	local hrp = getHRP()
	if hrp then
		local bav = hrp:FindFirstChild("_AdminFlingBAV")
		if bav then bav:Destroy() end
		hrp.Velocity = Vector3.zero
	end
end

local function startFling(target, duration, isAll)
	local hrp = getHRP()
	if not hrp then return end
	if not target then return end
	
	stopFling()
	S.flinging = true
	
	if not isAll then _flingOldPos = hrp.CFrame end
	
	local bav = Instance.new("BodyAngularVelocity")
	bav.Name = "_AdminFlingBAV"
	bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
	bav.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	bav.Parent = hrp
	
	local t = 0
	S.flingConn = conn(RunService.Heartbeat:Connect(function(dt)
		if not S.flinging then return end
		if not target.Character then return end
		local targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
		if not targetHrp then return end
		
		t = t + dt * 30
		local offset = Vector3.new(math.sin(t) * 2, math.cos(t) * 2, math.sin(t*0.5) * 2)
		
		hrp.Velocity = Vector3.new(10000, 10000, 10000)
		hrp.CFrame = CFrame.new(targetHrp.Position + offset)
	end))
	
	task.delay(duration or 4, function()
		if S.flinging then
			stopFling()
			if not isAll then
				if hrp and _flingOldPos then hrp.CFrame = _flingOldPos; _flingOldPos = nil end
				notify("Fling attempt ended", "info")
			end
		end
	end)
end

local function startFlingAll()
	stopFlingAll()
	S.flingAllOn = true
	local hrp = getHRP()
	if hrp then _flingOldPos = hrp.CFrame end
	
	S.flingAllThread = task.spawn(function()
		while S.flingAllOn do
			local targets = {}
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP then table.insert(targets, p) end
			end
			
			if #targets == 0 then
				task.wait(1)
			else
				for _, target in ipairs(targets) do
					if not S.flingAllOn then break end
					if target and target.Parent then
						startFling(target, 1.5, true)
						task.wait(1.5)
					end
				end
			end
		end
	end)
end

